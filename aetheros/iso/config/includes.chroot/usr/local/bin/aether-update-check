#!/usr/bin/env bash
# Aether update check.
# - As the system timer (no GUI session): refresh the apt lists only.
# - At desktop login (autostart, GUI session present): open the signed updater
#   dialog, which reads the verified release manifest and keeps install
#   disabled unless the Ed25519 signature is VALID.
set -uo pipefail

GUI_SESSION="${WAYLAND_DISPLAY:-${DISPLAY:-}}"

if [ -z "$GUI_SESSION" ]; then
  # System timer path: no user session, just refresh package lists.
  apt-get update -y >/dev/null 2>&1 || true
  exit 0
fi

# GUI path: the updater app performs the offline signature-verified check.
exec aether-updater
