#!/usr/bin/env python3
import pathlib, subprocess, sys
candidates = [
    pathlib.Path("/usr/share/aether/updater/aether-updater.py"),
    pathlib.Path(__file__).parent / "aether-updater.py",
]
for c in candidates:
    if c.exists():
        sys.exit(subprocess.call([sys.executable, str(c)] + sys.argv[1:]))
print("aether-updater not found", file=sys.stderr)
sys.exit(1)
