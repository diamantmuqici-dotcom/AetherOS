#!/usr/bin/env python3
import pathlib, subprocess, sys
# wrapper: launch aether-setup.py from installed location or payload copy
candidates = [
    pathlib.Path("/usr/share/aether/setup/aether-setup.py"),
    pathlib.Path(__file__).parent / "aether-setup.py",
    pathlib.Path.home() / "aetheros/setup/aether-setup.py",
]
for c in candidates:
    if c.exists():
        sys.exit(subprocess.call([sys.executable, str(c)] + sys.argv[1:]))
print("aether-setup not found", file=sys.stderr)
sys.exit(1)
