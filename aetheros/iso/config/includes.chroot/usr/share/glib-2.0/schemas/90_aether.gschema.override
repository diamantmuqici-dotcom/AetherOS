[org.gnome.desktop.interface]
gtk-theme='Aether-Dark'
color-scheme='prefer-dark'
enable-animations=true
enable-hot-corners=false
cursor-size=32
font-name='Inter 11'
document-font-name='Inter 11'

[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/aether/cosmos-nebula.jpg'
picture-uri-dark='file:///usr/share/backgrounds/aether/cosmos-nebula.jpg'
picture-options='zoom'
primary-color='#08090C'

[org.gnome.shell]
favorite-apps=['aether-browser.desktop', 'aether-mail.desktop', 'aether-vault.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Console.desktop', 'org.aether.Settings.desktop']
enabled-extensions=['dash-to-dock@example.com']
welcome-dialog-last-shown-version='48'

[org.gnome.shell.extensions.dash-to-dock]
dock-position='BOTTOM'
extend-height=true
autohide=false
dash-max-icon-size=40
show-mounts=false
show-show-apps-button=true
show-trash=false

[org.gnome.desktop.peripherals.mouse]
speed=0.0
natural-scroll=false

[org.gnome.desktop.peripherals.keyboard]
delay=500
repeat-interval=30

[org.gnome.desktop.notifications]
show-banners=true
show-in-lock-screen=true

[org.gnome.mutter]
experimental-features=['scale-monitor-framebuffer']
